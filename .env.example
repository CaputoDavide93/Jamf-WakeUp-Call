# Jamf Pro Configuration

# Required: Jamf Pro server URL (no default — the script exits if unset)
JAMF_PRO_URL=https://your-jamf-instance.jamfcloud.com

# Authentication Method 1: Username & Password
JAMF_PRO_USERNAME=your_username
JAMF_PRO_PASSWORD=your_password

# Authentication Method 2: API Token (recommended)
# JAMF_PRO_API_TOKEN=your_bearer_token

# Optional: Default dynamic group ID for group mode
# JAMF_DYNAMIC_GROUP_ID=42

# Optional: Logging configuration
LOG_LEVEL=INFO
LOG_FILE=jamf_wakeup.log
API_TIMEOUT=30
